{
    "schemaVersion": 1,
    "id": "infrawerk",
    "version": "${version}",
    "name": "InfraWerk",
    "description": "Station Decorations and Railway Infrastructure for Minecraft.",
    "authors": ["Arrokoth233", "Radekemia", "RAO_dIE"],
    "contact": {},
    "license": "MIT",
    "icon": "assets/infrawerk/icon.png",
    "environment": "*",
    "entrypoints": {
        "fabric-datagen": [
            "team.dovecot.infrawerk.client.InfraWerkDataGenerator"
        ],
        "client": [
            "team.dovecot.infrawerk.client.InfraWerkClient"
        ],
        "main": [
            "team.dovecot.infrawerk.common.InfraWerk"
        ]
    },
    "mixins": [
        "infrawerk.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "metropolis": ">=${metropolis_version}"
    }
}
